{
  "name": "birlikte-izle",
  "private": true,
  "description": "Uzakta olsanız da yan yana gibi: birlikte dizi izleme uygulaması",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run dev -w @birlikte/desktop",
    "dev:ikinci": "npm run dev:ikinci -w @birlikte/desktop",
    "dev:web": "npm run dev:web -w @birlikte/desktop",
    "dev:signal": "npm run dev -w @birlikte/signal",
    "build": "npm run build -w @birlikte/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
