{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birlikte-izle-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Web sürümü (tarayıcıdan/telefondan katılma) aynı adresten sunulur.
  // API yolları önce Worker'a gider; geri kalan her şey web uygulamasıdır.
  "assets": {
    "directory": "./web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/pair/*", "/ice", "/room/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "PAIRING", "class_name": "Pairing" }
    ]
  },
  // SQLite tabanlı Durable Object'ler Workers ücretsiz planında da var.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Pairing"] }],
  "observability": { "enabled": true }
}
