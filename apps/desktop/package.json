{
  "name": "@birlikte/desktop",
  "version": "0.3.6",
  "private": true,
  "description": "Birlikte İzle masaüstü uygulaması",
  "productName": "Birlikte İzle",
  "author": "Birlikte İzle",
  "homepage": "https://github.com/ekinciimuhammed/birlikte-izle",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ikinci": "node scripts/dev-ikinci.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts --outDir ../../../../services/signal/web --emptyOutDir",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "node test/e2e.mjs",
    "test:electron": "node test/electron.mjs",
    "test:media": "node test/media.mjs",
    "test:packaged": "node test/packaged.mjs",
    "test:phone": "node test/phone.mjs",
    "test:sync": "node test/sync.mjs",
    "test:youtube": "node test/youtube.mjs",
    "test:camera": "node test/camera.mjs",
    "test:extension": "node test/extension.mjs",
    "test:web": "node test/web.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.config.cjs --dir"
  },
  "devDependencies": {
    "@birlikte/protocol": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "webm-muxer": "^5.1.4",
    "ws": "8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
