{
  "manifest_version": 3,
  "name": "Birlikte İzle",
  "description": "Netflix, Disney+, Prime Video, YouTube ve diğerlerini Birlikte İzle uygulamasıyla, sevdiğinle aynı anda izle; kameralarınız sitenin üstünde.",
  "version": "0.4.1",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Birlikte İzle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/gp/video/*",
    "*://*.amazon.com.tr/gp/video/*",
    "*://*.amazon.de/gp/video/*",
    "*://*.amazon.co.uk/gp/video/*",
    "*://*.max.com/*",
    "*://*.hbomax.com/*",
    "*://*.youtube.com/*",
    "*://*.blutv.com/*",
    "*://*.exxen.com/*",
    "*://*.gain.tv/*",
    "*://*.tabii.com/*",
    "*://*.puhutv.com/*",
    "*://*.mubi.com/*",
    "*://tv.apple.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.tvplus.com.tr/*",
    "*://*.atv.com.tr/*",
    "*://*.kanald.com.tr/*",
    "*://*.showtv.com.tr/*",
    "*://*.startv.com.tr/*",
    "*://*.nowtv.com.tr/*",
    "*://*.tv8.com.tr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com.tr/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.youtube.com/*",
        "*://*.blutv.com/*",
        "*://*.exxen.com/*",
        "*://*.gain.tv/*",
        "*://*.tabii.com/*",
        "*://*.puhutv.com/*",
        "*://*.mubi.com/*",
        "*://tv.apple.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.tvplus.com.tr/*",
        "*://*.atv.com.tr/*",
        "*://*.kanald.com.tr/*",
        "*://*.showtv.com.tr/*",
        "*://*.startv.com.tr/*",
        "*://*.nowtv.com.tr/*",
        "*://*.tv8.com.tr/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "sites.js",
        "content.js",
        "cams.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "netflix.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
